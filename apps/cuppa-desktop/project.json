{
  "name": "cuppa-desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cuppa-desktop",
  "tags": [
    "type:go-app"
  ],
  "targets": {
    "build": {
      "executor": "@nx-go/nx-go:build",
      "outputs": [
        "{workspaceRoot}/dist/apps/cuppa-desktop"
      ],
      "options": {
        "outputPath": "../../dist/apps/cuppa-desktop/cuppa-desktop"
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test"
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint",
      "parallelism": false,
      "options": {
        "linter": "golangci-lint",
        "args": [
          "run"
        ]
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "wails dev",
        "cwd": "apps/cuppa-desktop"
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/build/bin"
      ],
      "options": {
        "command": "wails build",
        "cwd": "apps/cuppa-desktop"
      }
    }
  }
}
